# Mẫu biến môi trường — copy sang .env rồi điền giá trị thật.
# cp .env.example .env
# Sau khi đổi .env cần restart Metro với cache clear: npx expo start -c

# API backend
SERVER_API=http://localhost:8080
WS_URL=ws://localhost:9091/app_socket

# Storage dùng cho upload media: 'r2' (mặc định, khớp web) hoặc 'supabase' (fallback).
STORAGE_PROVIDER=r2

# Cloudflare R2 — Dashboard > R2 > Manage API Tokens (S3-compatible credentials).
# R2_PUBLIC_URL là domain công khai của bucket (r2.dev hoặc custom domain), không có "/" ở cuối.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=media
R2_PUBLIC_URL=

# Supabase (fallback khi R2 chưa cấu hình). Supabase Dashboard > Project Settings > API.
SUPABASE_URL=
SUPABASE_KEY=
SUPABASE_MEDIA_BUCKET=media

# WebRTC (Metered.ca TURN server — lấy credential từ metered.ca dashboard)
TURN_USERNAME=
TURN_CREDENTIAL=
